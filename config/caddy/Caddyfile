# Caddyfile for Nextcloud Server on Windows
:8080 {
    root * nextcloud
    encode zstd gzip

    # Request limits for high-speed file sync
    request_body {
        max_size 0
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-Robots-Tag "noindex, nofollow"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "no-referrer"
    }

    # CalDAV and CardDAV redirects
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301
    redir /.well-known/webfinger /index.php/.well-known/webfinger 301
    redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301

    # Block access to hidden files and sensitive directories
    @forbidden {
        path /.htaccess
        path /data/*
        path /config/*
        path /db_structure
        path /.xml
        path /README
        path /3rdparty/*
        path /lib/*
        path /templates/*
        path /autotest*
        path /occ
        path /issue*
        path /indie*
        path /db_*
        path /console*
    }
    respond @forbidden 404

    # PHP FastCGI handler with immediate response streaming (prevents Cloudflare 524 timeouts)
    php_fastcgi 127.0.0.1:9000 {
        root nextcloud
        env front_controller_active true
        split .php
        index index.php
        flush_interval -1
    }

    # Media streaming header (Cloudflare TOS & private video compliance)
    @media {
        path *.mp4 *.mov *.mkv *.avi *.webm *.heic *.dng *.flac
    }
    header @media {
        Cache-Control "private, no-transform"
    }

    # Standalone Desktop UI route
    handle_path /_dashboard* {
        root * ui
        file_server
    }

    # Serve static assets directly
    file_server
}
